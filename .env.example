OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Set an optional password to protect room creation on a public deployment.
HOST_PASSWORD=
# The narrator's Realtime model and voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Explicit offline mode; never silently substitutes for live AI.
DEMO_MODE=false
